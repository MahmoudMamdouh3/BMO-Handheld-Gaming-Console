{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "project": "BMO-Handheld-Gaming-Console",
  "version": "3.0.0",
  "ruleset_version": 5,
  "sdd_version": "3.0",
  "hardware": {
    "mcu": "ESP32-S3-N16R8",
    "cpu_frequency_mhz": 240,
    "flash_mode": "opi",
    "flash_size_mb": 16,
    "psram_mode": "opi",
    "psram_size_mb": 8,
    "display": {
      "controller": "ST7789VW",
      "resolution": "240x320",
      "logical_resolution": "320x240",
      "rotation": 3,
      "pixel_format": "BGR565_BYTESWAPPED",
      "bus": "FSPI",
      "clock_mhz": 80,
      "pins": {
        "sck": 12,
        "mosi": 11,
        "cs": 10,
        "dc": 8,
        "rst": 9
      }
    },
    "sd_card": {
      "status": "ACTIVE",
      "bus": "FSPI",
      "pins": {
        "miso": 15,
        "cs": 13,
        "sck": 12,
        "mosi": 11
      }
    },
    "buttons": {
      "status": "ACTIVE",
      "logic": "ACTIVE_LOW_INPUT_PULLUP",
      "polling": "ATOMIC_GPIO_IN_REG",
      "pins": {
        "up": 4,
        "down": 5,
        "left": 6,
        "right": 7,
        "a": 16,
        "b": 17,
        "start": 18,
        "select": 21
      }
    },
    "dormant_peripherals": {
      "battery_monitor": {
        "status": "DORMANT",
        "pin": 1,
        "flag": "FEATURE_BATTERY_MONITOR",
        "value": 0
      },
      "audio_i2s": {
        "status": "DORMANT",
        "pins": {
          "bclk": 38,
          "lrc": 39,
          "din": 40
        },
        "flag": "FEATURE_AUDIO",
        "value": 0
      },
      "fram_i2c": {
        "status": "DORMANT_RESERVED",
        "pins": {
          "sda": 43,
          "scl": 44
        }
      }
    }
  },
  "build": {
    "arduino_cli_fqbn": "esp32:esp32:esp32s3:FlashMode=opi,FlashSize=16M,PartitionScheme=custom,PSRAM=opi",
    "sketch_path": "firmware/BmoGameboy",
    "validation_command": "python scripts/validate_repo.py",
    "test_command": "python -m unittest discover tests"
  },
  "emulators": [
    {
      "name": "Walnut-CGB",
      "type": "ROM_GBC",
      "extension": ".gbc",
      "wrapper": "src/emulators/emu_walnut.cpp",
      "engine": "src/engine/walnut_cgb/walnut_cgb.h",
      "engine_status": "production",
      "build_verified": false,
      "last_hardware_verified": null,
      "notes": "16-bit fast paths reverted to 0 (stable). FIXED_UNVERIFIED on hardware."
    },
    {
      "name": "Peanut-GB",
      "type": "ROM_GB",
      "extension": ".gb",
      "wrapper": "src/emulators/emu_peanut.cpp",
      "engine": "src/vendor/peanut_gb/peanut_gb.h",
      "engine_status": "production",
      "build_verified": false,
      "last_hardware_verified": null
    },
    {
      "name": "Agnes",
      "type": "ROM_NES",
      "extension": ".nes",
      "wrapper": "src/emulators/emu_nes.cpp",
      "engine": "src/vendor/agnes/agnes.c",
      "engine_status": "production",
      "build_verified": false,
      "last_hardware_verified": null
    },
    {
      "name": "doomgeneric",
      "type": "ROM_WAD",
      "extension": ".wad",
      "wrapper": "src/emulators/emu_doom.cpp",
      "engine": "src/vendor/doom/",
      "engine_status": "production",
      "build_verified": false,
      "last_hardware_verified": null
    },
    {
      "name": "SMSPlus",
      "type": "ROM_SMS_GG",
      "extension": ".sms / .gg",
      "wrapper": "src/emulators/emu_sms.cpp",
      "engine": "src/vendor/smsplus/sms.c",
      "engine_status": "production",
      "build_verified": false,
      "last_hardware_verified": null
    },
    {
      "name": "PCE-Stub",
      "type": "ROM_PCE",
      "extension": ".pce",
      "wrapper": "src/emulators/emu_pce.cpp",
      "engine": "src/vendor/pce/pce.c",
      "engine_status": "stub",
      "build_verified": false,
      "last_hardware_verified": null,
      "notes": "STUB_ENGINE: renders blank framebuffer only. No HuC6280 emulation."
    },
    {
      "name": "Stella-Stub",
      "type": "ROM_ATARI",
      "extension": ".a26",
      "wrapper": "src/emulators/emu_atari.cpp",
      "engine": "src/vendor/stella/atari.c",
      "engine_status": "stub",
      "build_verified": false,
      "last_hardware_verified": null,
      "notes": "STUB_ENGINE: renders blank framebuffer only. No 6507 emulation."
    },
    {
      "name": "PICO-8-Stub",
      "type": "ROM_PICO8",
      "extension": ".p8",
      "wrapper": "src/emulators/emu_pico.cpp",
      "engine": "src/vendor/pico/pico.c",
      "engine_status": "stub",
      "build_verified": false,
      "last_hardware_verified": null,
      "notes": "STUB_ENGINE: renders blank framebuffer only. No Lua VM."
    },
    {
      "name": "Genesis-Stub",
      "type": "ROM_GENESIS",
      "extension": ".gen / .md / .smd",
      "wrapper": "src/emulators/emu_genesis.cpp",
      "engine": "src/vendor/genesis/genesis.c",
      "engine_status": "stub",
      "build_verified": false,
      "last_hardware_verified": null,
      "notes": "STUB_ENGINE: renders solid background only. No 68000 emulation."
    },
    {
      "name": "SNES-Stub",
      "type": "ROM_SNES",
      "extension": ".sfc / .smc",
      "wrapper": "src/emulators/emu_snes.cpp",
      "engine": "src/vendor/snes/snes.c",
      "engine_status": "stub",
      "build_verified": false,
      "last_hardware_verified": null,
      "notes": "STUB_ENGINE: renders blank framebuffer only. No 65C816 emulation."
    },
    {
      "name": "WonderSwan-Stub",
      "type": "ROM_WSWAN",
      "extension": ".ws / .wsc",
      "wrapper": "src/emulators/emu_wswan.cpp",
      "engine": "src/vendor/wswan/wswan.c",
      "engine_status": "stub",
      "build_verified": false,
      "last_hardware_verified": null,
      "notes": "STUB_ENGINE: renders blank framebuffer only. No V30 MZ emulation."
    },
    {
      "name": "NGP-Stub",
      "type": "ROM_NGP",
      "extension": ".ngp / .ngc",
      "wrapper": "src/emulators/emu_ngp.cpp",
      "engine": "src/vendor/ngp/ngp.c",
      "engine_status": "stub",
      "build_verified": false,
      "last_hardware_verified": null,
      "notes": "STUB_ENGINE: renders blank framebuffer only. No TLCS-900H emulation."
    },
    {
      "name": "Lynx-Stub",
      "type": "ROM_LYNX",
      "extension": ".lnx",
      "wrapper": "src/emulators/emu_lynx.cpp",
      "engine": "src/vendor/lynx/lynx.c",
      "engine_status": "stub",
      "build_verified": false,
      "last_hardware_verified": null,
      "notes": "STUB_ENGINE: renders blank framebuffer only. No 65SC02/Suzy emulation."
    },
    {
      "name": "ColecoVision-Stub",
      "type": "ROM_COLEM",
      "extension": ".col / .sg",
      "wrapper": "src/emulators/emu_colem.cpp",
      "engine": "src/vendor/colem/colem.c",
      "engine_status": "stub",
      "build_verified": false,
      "last_hardware_verified": null,
      "notes": "STUB_ENGINE: renders blank framebuffer only. No Z80/TMS9918A emulation."
    }
  ]
}
